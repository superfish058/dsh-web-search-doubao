{
  "name": "dsh-web-search-doubao",
  "description": "Doubao Search (Volcengine 豆包搜索) web search provider for the DeepSeek Harness — dedicated settings GUI card, key stored via the credentials service, billed separately from any model spend",
  "version": "0.2.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": "./lib/client.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "lib/*.js.map",
    "lib/types/**/*.d.ts",
    "src",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "license": "MIT",
  "author": {
    "name": "Kenny",
    "url": "https://github.com/kenny2077"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenny2077/dsh-web-search-doubao.git"
  },
  "homepage": "https://github.com/kenny2077/dsh-web-search-doubao#readme",
  "bugs": {
    "url": "https://github.com/kenny2077/dsh-web-search-doubao/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "doubao",
    "doubao-search",
    "volcengine",
    "bytedance",
    "web-search",
    "search-provider"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc --build && tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/doubao.spec.ts tests/client-card.spec.ts",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-credentials": "*",
    "@deepseek-ai/dsh-invariants": "*",
    "@deepseek-ai/dsh-launch-environment": "*",
    "@deepseek-ai/dsh-settings": "*",
    "@deepseek-ai/dsh-web": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cosmokit": "^1.8.2",
    "@deepseek-ai/dsh-credentials": "0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "0.1.1-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.1-rc.2",
    "@deepseek-ai/dsh-web": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^22.19.0",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
